<div class="treasure-chest-browser">
  <div class="browser-toolbar">
    <label>
      <span>{{localize "TREASURE_CHEST.Browser.Source"}}</span>
      <select data-role="source">
        {{#each sources}}
        <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </label>
    <label>
      <span>{{localize "TREASURE_CHEST.Browser.Search"}}</span>
      <input type="search" data-role="search" value="{{query}}" placeholder="{{localize "TREASURE_CHEST.Browser.Search"}}">
    </label>
  </div>

  {{#if loadError}}
  <p class="hint">{{localize "TREASURE_CHEST.Browser.Error"}}</p>
  {{/if}}
  <p class="browser-count" data-role="count"></p>

  <ul class="browser-results">
    {{#each entries}}
    <li data-item-id="{{id}}" data-name="{{nameLower}}">
      <label>
        <input type="checkbox" data-role="pick" value="{{id}}">
        {{#if img}}<img src="{{img}}" alt="">{{/if}}
        <span>{{name}}</span>
      </label>
    </li>
    {{/each}}
  </ul>

  <div class="browser-actions">
    <button type="button" data-action="addSelected">
      {{localize "TREASURE_CHEST.Actions.AddSelected"}}
    </button>
  </div>
</div>
