<div class="treasure-chest-sheet">
  <header class="chest-header">
    {{#if editable}}
    <button type="button" class="portrait-button" data-action="editImage">
      <img class="profile-img" src="{{item.img}}" alt="">
    </button>
    {{else}}
    <img class="profile-img" src="{{item.img}}" alt="">
    {{/if}}
    <div class="header-fields">
      {{#if editable}}
      <input type="text" name="name" value="{{item.name}}">
      {{else}}
      <h2>{{item.name}}</h2>
      {{/if}}
      <p class="hint">{{hint}}</p>
    </div>
  </header>

  {{#if lootingBlocked}}
  <p class="combat-warning">{{localize "TREASURE_CHEST.Sheet.Combat"}}</p>
  {{/if}}
  {{#if sealed}}
  <p class="combat-warning">{{localize "TREASURE_CHEST.Sheet.Sealed"}}</p>
  {{/if}}

  <section class="security">
    <h3>{{localize "TREASURE_CHEST.Security.Title"}}</h3>
    {{#if security.locked}}
      {{#if security.unlocked}}
      <p class="hint">{{localize "TREASURE_CHEST.Security.StatusUnlocked"}}</p>
      {{else}}
      <p class="hint">{{localize "TREASURE_CHEST.Security.StatusLocked"}}</p>
      {{/if}}
    {{/if}}
    {{#if security.trapped}}
      {{#if security.disarmed}}
      <p class="hint">{{localize "TREASURE_CHEST.Security.StatusDisarmed"}}</p>
      {{else if security.triggered}}
      <p class="hint">{{localize "TREASURE_CHEST.Security.StatusTriggered"}}</p>
      {{else if security.understood}}
      <p class="hint">{{localize "TREASURE_CHEST.Security.StatusTrapped"}} {{security.trapName}}</p>
      {{else if security.detected}}
      <p class="hint">{{localize "TREASURE_CHEST.Security.StatusUnclear"}}</p>
      {{else if editable}}
      <p class="hint">{{localize "TREASURE_CHEST.Security.StatusHidden"}} {{security.trapName}}</p>
      {{/if}}
    {{/if}}

    {{#if editable}}
    <div class="security-checks">
      <label><input type="checkbox" name="security.locked" {{#if security.locked}}checked{{/if}}> {{localize "TREASURE_CHEST.Security.Locked"}}</label>
      <label><input type="checkbox" name="security.trapped" {{#if security.trapped}}checked{{/if}}> {{localize "TREASURE_CHEST.Security.Trapped"}}</label>
      <label><input type="checkbox" name="security.unlocked" {{#if security.unlocked}}checked{{/if}}> {{localize "TREASURE_CHEST.Security.Unlocked"}}</label>
      <label><input type="checkbox" name="security.detected" {{#if security.detected}}checked{{/if}}> {{localize "TREASURE_CHEST.Security.Detected"}}</label>
      <label><input type="checkbox" name="security.understood" {{#if security.understood}}checked{{/if}}> {{localize "TREASURE_CHEST.Security.Understood"}}</label>
      <label><input type="checkbox" name="security.disarmed" {{#if security.disarmed}}checked{{/if}}> {{localize "TREASURE_CHEST.Security.Disarmed"}}</label>
      <label><input type="checkbox" name="security.triggered" {{#if security.triggered}}checked{{/if}}> {{localize "TREASURE_CHEST.Security.Triggered"}}</label>
    </div>
    <div class="security-grid">
      <label>
        <span>{{localize "TREASURE_CHEST.Security.LockDc"}}</span>
        <input type="number" name="security.lockDc" value="{{security.lockDc}}" min="0" step="1">
      </label>
      <label>
        <span>{{localize "TREASURE_CHEST.Security.ForceDc"}}</span>
        <input type="number" name="security.forceDc" value="{{security.forceDc}}" min="0" step="1">
      </label>
      <label>
        <span>{{localize "TREASURE_CHEST.Security.Preset"}}</span>
        <select name="security.preset">
          {{#each security.presets}}
          <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </label>
      <label>
        <span>{{localize "TREASURE_CHEST.Security.DetectDc"}}</span>
        <input type="number" name="security.detectDc" value="{{security.detectDc}}" min="0" step="1">
      </label>
      <label>
        <span>{{localize "TREASURE_CHEST.Security.UnderstandWith"}}</span>
        <select name="security.understandSkill">
          {{#each security.understandSkills}}
          <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </label>
      <label>
        <span>{{localize "TREASURE_CHEST.Security.UnderstandDc"}}</span>
        <input type="number" name="security.understandDc" value="{{security.understandDc}}" min="0" step="1">
      </label>
      <label>
        <span>{{localize "TREASURE_CHEST.Security.DisarmWith"}}</span>
        <select name="security.disarmSkill">
          {{#each security.disarmSkills}}
          <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </label>
      <label>
        <span>{{localize "TREASURE_CHEST.Security.DisarmDc"}}</span>
        <input type="number" name="security.disarmDc" value="{{security.disarmDc}}" min="0" step="1">
      </label>
      <label>
        <span>{{localize "TREASURE_CHEST.Security.Save"}}</span>
        <select name="security.saveAbility">
          {{#each security.saves}}
          <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </label>
      <label>
        <span>{{localize "TREASURE_CHEST.Security.SaveDc"}}</span>
        <input type="number" name="security.saveDc" value="{{security.saveDc}}" min="0" step="1">
      </label>
      <label>
        <span>{{localize "TREASURE_CHEST.Security.DamageFormula"}}</span>
        <input type="text" name="security.damageFormula" value="{{security.damageFormula}}">
      </label>
      <label>
        <span>{{localize "TREASURE_CHEST.Security.DamageType"}}</span>
        <select name="security.damageType">
          {{#each security.damageTypes}}
          <option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </label>
    </div>
    <label>
      <span>{{localize "TREASURE_CHEST.Security.Rider"}}</span>
      <input type="text" name="security.rider" value="{{security.rider}}">
    </label>
    {{/if}}

    <div class="chest-toolbar">
      {{#if security.showExamine}}
      <button type="button" data-action="examine">{{localize "TREASURE_CHEST.Security.Examine"}}</button>
      {{/if}}
      {{#if security.showUnderstand}}
      <button type="button" data-action="understand">{{security.understandLabel}}</button>
      {{/if}}
      {{#if security.showDisarm}}
      <button type="button" data-action="disarm">{{localize "TREASURE_CHEST.Security.Disarm"}}</button>
      {{/if}}
      {{#if security.showUnlock}}
      <button type="button" data-action="unlock" {{#if security.unlockBlocked}}disabled{{/if}}>{{localize "TREASURE_CHEST.Security.Unlock"}}</button>
      <button type="button" data-action="force" {{#if security.unlockBlocked}}disabled{{/if}}>{{localize "TREASURE_CHEST.Security.Force"}}</button>
      {{/if}}
    </div>
    {{#if security.showRequests}}
    <p class="hint">{{localize "TREASURE_CHEST.Security.RequestHint"}}</p>
    {{/if}}
  </section>

  <section>
    <h3>{{localize "TREASURE_CHEST.Sheet.Coins"}}</h3>
    <div class="currency-grid">
      {{#each denominations}}
      <label class="denom">
        <span class="denom-label">{{label}}</span>
        <span class="denom-controls">
          <input type="number" name="currency.{{key}}" value="{{value}}" min="0" step="1" {{#unless ../editable}}disabled{{/unless}}>
          <button type="button" data-action="takeDenom" data-denom="{{key}}" title="{{takeLabel}}" {{#unless ../canTake}}disabled{{/unless}}>
            <i class="fas fa-hand-paper"></i>
          </button>
        </span>
      </label>
      {{/each}}
    </div>
  </section>

  <section class="destination">
    <label>
      <span>{{localize "TREASURE_CHEST.Sheet.Destination"}}</span>
      <select data-role="actor">
        {{#each actors}}
        <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
        {{/each}}
      </select>
    </label>
  </section>
  <p class="hint">{{localize "TREASURE_CHEST.Sheet.DestinationHint"}}</p>
  {{#unless hasDestination}}
  <p class="hint">{{localize "TREASURE_CHEST.Sheet.NoDestination"}}</p>
  {{/unless}}

  <div class="chest-toolbar">
    {{#if editable}}
    <button type="button" data-action="browse">
      <i class="fas fa-book-open"></i> {{localize "TREASURE_CHEST.Actions.Browse"}}
    </button>
    {{/if}}
    <button type="button" data-action="takeCoins" {{#unless canTake}}disabled{{/unless}}>
      {{localize "TREASURE_CHEST.Actions.TakeCoins"}}
    </button>
    <button type="button" data-action="takeAll" {{#unless canTake}}disabled{{/unless}}>
      {{localize "TREASURE_CHEST.Actions.TakeAll"}}
    </button>
  </div>

  <div class="chest-drop-zone">
    {{#each sections}}
    <section class="chest-section" data-category="{{id}}">
      <h3>{{label}} ({{count}})</h3>
      {{#if items.length}}
      <ol class="item-list">
        {{#each items}}
        <li class="item-row" data-entry-id="{{id}}" {{#if ../../canTake}}draggable="true" title="{{localize "TREASURE_CHEST.Sheet.DragRow"}}"{{/if}}>
          {{#if img}}<img src="{{img}}" alt="" draggable="false">{{/if}}
          <span class="item-name">{{name}}</span>
          {{#if rarity}}<span class="item-rarity">{{rarity}}</span>{{/if}}
          <span class="item-qty">&times;{{quantity}}</span>
          <button type="button" data-action="takeItem" {{#unless ../../canTake}}disabled{{/unless}}>
            {{localize "TREASURE_CHEST.Actions.Take"}}
          </button>
          {{#if ../../editable}}
          <button type="button" data-action="removeItem" title="{{localize "TREASURE_CHEST.Actions.Remove"}}">
            <i class="fas fa-trash"></i>
          </button>
          {{/if}}
        </li>
        {{/each}}
      </ol>
      {{else}}
      <p class="empty-hint">{{localize "TREASURE_CHEST.Sheet.EmptySection"}}</p>
      {{/if}}
    </section>
    {{/each}}
    <p class="empty-hint">{{localize "TREASURE_CHEST.Sheet.DragHint"}}</p>
    {{#if editable}}
    <p class="empty-hint">{{localize "TREASURE_CHEST.Sheet.DropHint"}}</p>
    {{/if}}
  </div>
</div>
